# 이미지 생성 공급자: gemini(기본) 또는 seedream
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# --- Seedream(ByteDance/BytePlus ModelArk) 사용 시 ---
SEEDREAM_API_KEY=your-byteplus-ark-api-key
# ModelArk 콘솔에서 정확한 모델 ID 확인 후 지정 (예: seedream-4-0)
SEEDREAM_MODEL=seedream-4-0
# 리전 엔드포인트가 다르면 교체
SEEDREAM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
DAILY_USER_LIMIT=3
DAILY_TOTAL_LIMIT=200
# 쉼표 구분. 비우면 config/trends.ts 기본값 사용
TREND_KEYWORDS=
# 1이면 API 호출 없이 ref/ 샘플 이미지로 목 응답 (로컬 개발 전용, 과금 없음)
# IMAGE_PROVIDER와 무관하게 전부 막힌다 — 목 모드는 이것 하나만 켜면 된다
IMAGE_MOCK=
# 아래 둘은 예전 이름. 기존 스크립트 호환용으로 계속 인정한다
GEMINI_MOCK=
SEEDREAM_MOCK=
# --- Stripe 결제 ---
# 이용권(평생 9,900원 / 얼리버드 4,900원 선착순 100명) 판매용.
# 카드번호는 Stripe Checkout이 처리 — 이 앱은 참조 ID만 보관한다.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# 얼리버드 쿠폰(5000원 할인, 최대 100회). 비우면 정가로만 판매
STRIPE_EARLYBIRD_COUPON_ID=
